# ---- NextStep environment -------------------------------------------------
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# Gemini (server-only). Leave blank to run in Demo Mode with deterministic
# local analysis. Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Any multimodal Gemini model available to your key.
# Default when blank: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Optional API base override. Leave blank in normal use (official Google
# endpoint). Only set this to point the same client at a local stub when
# verifying token usage in tests.
GEMINI_BASE_URL=
# Free-tier request-count guards (defaults mirror Google AI Studio flash
# limits: 5 requests/minute, 20 requests/day). Raise them with a paid key.
GEMINI_MAX_RPM=5
GEMINI_MAX_RPD=20

# Server
PORT=5000
NODE_ENV=development

# Local SQLite database file (created automatically on first start).
DATABASE_PATH=./server/data/nextstep.db

# ---- Manus scaffold values (optional for standalone local use) -------------
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Legacy MySQL URL from the Manus scaffold — NOT used by NextStep (SQLite only).
DATABASE_URL=
